	pages = {199--217},
	file = {PDF:/Users/gidonkaminer/Zotero/storage/T27GJVR9/Piantadosi et al. - 2012 - Bootstrapping in a language of thought A formal model of numerical concept learning.pdf:application/pdf},
}

