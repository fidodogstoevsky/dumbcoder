@article{kovacs_social_2010,
	title = {The {Social} {Sense}: {Susceptibility} to {Others}’ {Beliefs} in {Human} {Infants} and {Adults}},
	volume = {330},
	issn = {0036-8075, 1095-9203},
	shorttitle = {The {Social} {Sense}},
	url = {https://www.science.org/doi/10.1126/science.1190792},
	doi = {10.1126/science.1190792},
	abstract = {Mind Reading
            
              One core component of social cognition, especially of the kind practiced by humans, is the capacity to formulate a representation of what someone else believes to be true, even if that belief is not anchored in reality. Holding two such beliefs in mind—one false and one true—is no simple feat, and up until a few years ago, it was generally accepted that such a capacity did not arise until children were 3 to 4 years old. Since then, a flurry of studies, using a variety of interrogation measures, has suggested that much-younger humans might, in fact, possess this capacity, commonly referred to as a theory of mind.
              
                Kovács
                et al.
              
              (p.
              1830
              ) devised an ingenious behavioral paradigm and applied it both to adults and to infants, which suggests that the representations of others' beliefs are indeed formed in the same way in adults and in infants.
            
          , 
            Knowledge of what others believe is present in 7-month-old infants.
          , 
            Human social interactions crucially depend on the ability to represent other agents’ beliefs even when these contradict our own beliefs, leading to the potentially complex problem of simultaneously holding two conflicting representations in mind. Here, we show that adults and 7-month-olds automatically encode others’ beliefs, and that, surprisingly, others’ beliefs have similar effects as the participants’ own beliefs. In a visual object detection task, participants’ beliefs and the beliefs of an agent (whose beliefs were irrelevant to performing the task) both modulated adults’ reaction times and infants’ looking times. Moreover, the agent’s beliefs influenced participants’ behavior even after the agent had left the scene, suggesting that participants computed the agent’s beliefs online and sustained them, possibly for future predictions about the agent’s behavior. Hence, the mere presence of an agent automatically triggers powerful processes of belief computation that may be part of a “social sense” crucial to human societies.},
	language = {en},
	number = {6012},
	urldate = {2026-08-01},
	journal = {Science},
	author = {Kovács, Ágnes Melinda and Téglás, Ernő and Endress, Ansgar Denis},
	month = dec,
	year = {2010},
	note = {watchfolder-hash:d21e44472f0ead942df2032bd4f047c3fce858648b346e67754b64d72ba74bb3},
	pages = {1830--1834},
	file = {PDF:/Users/gidonkaminer/Zotero/storage/SVNZBWDK/Kovács - 2010 - The Social Sense Susceptibility to Others’ Beliefs in Human Infants and Adults.pdf:application/pdf},
}

@article{buttelmann_eighteen-month-old_2009,
	title = {Eighteen-month-old infants show false belief understanding in an active helping paradigm},
	volume = {112},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {00100277},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0010027709001115},
	doi = {10.1016/j.cognition.2009.05.006},
	abstract = {Recently, several studies have claimed that soon after their ﬁrst birthday infants understand others’ false beliefs. However, some have questioned these ﬁndings based on criticisms of the looking-time paradigms used. Here we report a new paradigm to test false belief understanding in infants using a more active behavioral response: helping. Speciﬁcally, the task was for infants to help an adult achieve his goal – but to determine that goal infants had to take into account what the adult believed (i.e., whether or not he falsely believed there was a toy inside a box). Results showed that by 18 months of age infants successfully took into account the adult’s belief in the process of attempting to determine his goal. Results for 16-month-olds were in the same direction but less clear. These results represent by far the youngest age of false belief understanding in a task with an active behavioral measure.},
	language = {en},
	number = {2},
	urldate = {2026-08-01},
	journal = {Cognition},
	author = {Buttelmann, David and Carpenter, Malinda and Tomasello, Michael},
	month = aug,
	year = {2009},
	note = {watchfolder-hash:17af5861a17e0f0c1040182097fbf552c745ca777979cf4da5e501d1a817a300},
	pages = {337--342},
	file = {PDF:/Users/gidonkaminer/Zotero/storage/DNFIYF6I/Buttelmann - 2009 - Eighteen-month-old infants show false belief understanding in an active helping paradigm.pdf:application/pdf},
}

@article{kulke_is_2018,
	title = {Is {Implicit} {Theory} of {Mind} a {Real} and {Robust} {Phenomenon}? {Results} {From} a {Systematic} {Replication} {Study}},
	volume = {29},
	issn = {0956-7976, 1467-9280},
	shorttitle = {Is {Implicit} {Theory} of {Mind} a {Real} and {Robust} {Phenomenon}?},
	url = {https://journals.sagepub.com/doi/10.1177/0956797617747090},
	doi = {10.1177/0956797617747090},
	abstract = {Recently, theory-of-mind research has been revolutionized by findings from novel implicit tasks suggesting that at least some aspects of false-belief reasoning develop earlier in ontogeny than previously assumed and operate automatically throughout adulthood. Although these findings are the empirical basis for far-reaching theories, systematic replications are still missing. This article reports a preregistered large-scale attempt to replicate four influential anticipatory-looking implicit theory-of-mind tasks using original stimuli and procedures. Results showed that only one of the four paradigms was reliably replicated. A second set of studies revealed, further, that this one paradigm was no longer replicated once confounds were removed, which calls its validity into question. There were also no correlations between paradigms, and thus, no evidence for their convergent validity. In conclusion, findings from anticipatory-looking false-belief paradigms seem less reliable and valid than previously assumed, thus limiting the conclusions that can be drawn from them.},
	language = {en},
	number = {6},
	urldate = {2026-08-01},
	journal = {Psychological Science},
	author = {Kulke, Louisa and Von Duhn, Britta and Schneider, Dana and Rakoczy, Hannes},
	month = jun,
	year = {2018},
	note = {watchfolder-hash:08f177f34fb27ac87182194f801fae97c7fc7056de50839191712bdf92436ebc},
	pages = {888--900},
	file = {PDF:/Users/gidonkaminer/Zotero/storage/67AXKL4S/Kulke - 2018 - Is Implicit Theory of Mind a Real and Robust Phenomenon Results From a Systematic Replication Study.pdf:application/pdf},
}

@article{dorrenberg_how_2018,
	title = {How (not) to measure infant {Theory} of {Mind}: {Testing} the replicability and validity of four non-verbal measures},
	volume = {46},
	issn = {08852014},
	shorttitle = {How (not) to measure infant {Theory} of {Mind}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0885201417300448},
	doi = {10.1016/j.cogdev.2018.01.001},
	abstract = {A growing body of infant studies with various implicit, non-verbal measures has suggested that Theory of Mind (ToM) may emerge much earlier than previously assumed. While explicit verbal ToM ﬁndings are highly replicable and show convergent validity, systematic replication studies of infant ToM, as well as convergent validations of these measures, are still missing. Here, we report a systematic study of the replicability and convergent validity of implicit ToM tasks using four diﬀerent measures with 24-month-olds (N = 66): Anticipatory looking, looking times and pupil dilation in violation-of-expectation paradigms, and spontaneous communicative interaction. Results of anticipatory looking and interaction-based tasks did not replicate previous ﬁndings, suggesting that these tasks do not reliably measure ToM. Looking time and new pupil dilation measures revealed sensitivity to belief-incongruent outcomes which interacted with the presentation order of outcomes, indicating limited evidence for implicit ToM processes under certain conditions. There were no systematic correlations of false belief processing between the tasks, thus failing to provide convergent validity. The present results suggest that the robustness and validity of existing implicit ToM tasks needs to be treated with more caution than previously practiced, and that not all non-verbal tasks and measures are equally suited to tap into implicit ToM processing.},
	language = {en},
	urldate = {2026-08-01},
	journal = {Cognitive Development},
	author = {Dörrenberg, Sebastian and Rakoczy, Hannes and Liszkowski, Ulf},
	month = apr,
	year = {2018},
	note = {watchfolder-hash:a6d29f0c99b8f12fff225ac0559cfd1609dcc1be74ac34fdede0b03faaabdfef},
	pages = {12--30},
	file = {PDF:/Users/gidonkaminer/Zotero/storage/TSVWX4SW/Dörrenberg - 2018 - How (not) to measure infant Theory of Mind Testing the replicability and validity of four non-verbal measures.pdf:application/pdf},
}

