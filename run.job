#!/bin/bash

#SBATCH --partition=genoa
#SBATCH --job-name=dumbcoder
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --time=08:00:00
#SBATCH --output=../dumbcoder-runs/slurm_%A.out

# Parameterized single-phase runner.
#
#     sbatch --job-name=<cell> run.job <cell> <script.py> [flags...]
#
# <cell> names the run: artifacts land in $RUNS/<cell>/, so the four cells of the
# dream ablation never overwrite each other's phase{1,2}_{run,traj,verdict}.json.
# Everything after <script.py> is forwarded verbatim to python.
#
#     sbatch --job-name=p1-dream   run.job p1-dream   phase1.py --t-fn 3600 --ecd-iters 6
#     sbatch --job-name=p1-nodream run.job p1-nodream phase1.py --t-fn 3600 --ecd-iters 6 --no-dream
#     sbatch --job-name=phase3 --time=02:00:00 run.job arity phase3_arity.py
#
# WHY THE OUTPUT DIR IS OUTSIDE THE CHECKOUT.  The phase artifacts are tracked
# files, so a run that writes them into the repo root dirties the tree it is
# reporting the commit of — build_provenance then stamps `<sha>+dirty` and the
# numbers are not citable.  (That, plus rsyncing sources over a stale checkout,
# is why every Jul-26 run carried the DIRTY warning.)  Keep $HOME/dumbcoder a
# clean `git pull`-ed checkout and let runs write elsewhere; git_provenance reads
# the repo via the source file's own path, so the cd below does not confuse it.
#
# Phase flags: --t-fn N (per-task fn timeout, sec)  --ecd-iters N (wake-sleep
#              rounds)  --k N (scenes per task)  --no-dream (uniform-Q baseline)
#              --smoke (tiny/fast)  --samples (one trajectory per family).
#
# The --output path above is relative to the SUBMIT dir ($SRC), i.e. it resolves to
# $RUNS/slurm_%A.out — deliberately OUTSIDE the checkout.  SLURM opens that file the
# moment the job starts, so a log written into $SRC would be an untracked file that
# dirties the tree, and the clean-tree guard below would fail the *next* submission
# on the *previous* job's log.  (.gitignore cannot fix this: it is itself untracked,
# so an ignore rule never reaches the cluster through git pull.)  $RUNS must exist
# before the first sbatch — `mkdir -p ~/dumbcoder-runs`.

set -u

SRC="$HOME/dumbcoder"          # clean checkout: source only, never written to
RUNS="$HOME/dumbcoder-runs"    # run outputs, outside the tree

if [ "$#" -lt 2 ]; then
  echo "usage: sbatch [--job-name=X] run.job <cell> <script.py> [flags...]" >&2
  exit 2
fi
CELL="$1"; SCRIPT="$2"; shift 2

module purge
module load 2023
module load Anaconda3/2023.07-2

# Activate our environment.  FAIL LOUDLY if the env is missing: the Jul-12 runs
# silently fell back to base conda (EnvironmentNameNotFound) and produced an
# unrecorded, unpinned interpreter — the exact confounder these reruns remove.
source activate dumbcoder || { echo "FATAL: could not activate conda env 'dumbcoder' — refusing to run on the fallback interpreter"; exit 1; }

# Stamp the interpreter + key package versions into the slurm log, so every run
# self-documents which environment it actually used.  stitch_core is imported here
# too and FAILS LOUDLY if absent: without it saturate_stitch silently degrades to
# "no compression", which produces a vacuous-(B) verdict with no error — the exact
# failure that cost the Jul-14 runs 4 of 7 criteria.  (stitch_core exposes no
# __version__, so we stamp its file path to prove which env it loaded from.)
python -c "import sys, numpy, torch, stitch_core; print('ENV', sys.executable, '| PY', sys.version.split()[0], '| numpy', numpy.__version__, '| torch', torch.__version__, '| stitch_core', stitch_core.__file__)" \
  || { echo 'FATAL: env stamp failed — stitch_core (or numpy/torch) not importable in env dumbcoder; refusing to run a no-compression job'; exit 1; }

# Refuse to launch a run whose numbers could not be cited afterwards.  A dirty
# source tree means the commit in the provenance header does not determine the
# run; better to fail in 2 seconds than to discover it 8 hours later in the log.
if [ -n "$(cd "$SRC" && git status --porcelain 2>/dev/null)" ]; then
  echo "FATAL: $SRC is dirty — commit/pull to a clean tree before a run whose numbers are cited:" >&2
  (cd "$SRC" && git status --short) >&2
  exit 1
fi
echo "SOURCE $SRC @ $(cd "$SRC" && git rev-parse --short HEAD) (clean)"

OUT="$RUNS/$CELL"
mkdir -p "$OUT"
cd "$OUT" || exit 1
export PYTHONPATH="$SRC:${PYTHONPATH:-}"
echo "CELL $CELL | writing artifacts to $OUT"

srun python "$SRC/$SCRIPT" "$@"
status=$?

# Park a copy of the slurm log next to the artifacts it describes, so each cell
# directory is self-contained.  The live log is $RUNS/slurm_<jobid>.out (see the
# --output directive); this copy is a snapshot taken as the job ends.
cp "$RUNS/slurm_${SLURM_JOB_ID}.out" "$OUT/${CELL}.log" 2>/dev/null

exit $status
